{
  "name": "@order-splitter/web",
  "version": "1.0.0",
  "private": true,
  "description": "Operator console for the order splitter (Next.js)",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
