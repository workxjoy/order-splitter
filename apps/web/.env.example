# Versioned base URL of the order splitter API (server-side only; never exposed to the browser)
API_BASE_URL=http://localhost:3001/api/v1

# Number of reverse proxies in front of the console that append to X-Forwarded-For. With 0 the
# console cannot tell a real browser address from one the browser made up, so it forwards none
# and all users share one API rate limit.
TRUSTED_PROXY_COUNT=0
