# --- Application ---
NODE_ENV=development
PORT=3001
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- HTTP ---
# Comma-separated list of browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Serves Swagger UI at /docs and the OpenAPI document at /docs/openapi.json
API_DOCS_ENABLED=true
# Rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL_MS per client IP
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Proxies allowed to set the client IP via X-Forwarded-For (the web console forwards the browser's):
# false | hop count | comma-separated IPs, CIDR ranges, loopback, linklocal, uniquelocal
TRUST_PROXY=loopback

# --- Trading ---
# Decimal places allowed for share quantities (0-9)
QUANTITY_DECIMAL_PLACES=3
# Fixed price per share when the partner does not send a market price
DEFAULT_STOCK_PRICE=100
# Minimum USD allocated to each stock (0 for no minimum)
MIN_ORDER_AMOUNT=1

# --- Market hours (Monday-Friday, minus holidays) ---
MARKET_TIMEZONE=America/New_York
MARKET_OPEN_TIME=09:30
MARKET_CLOSE_TIME=16:00
MARKET_EARLY_CLOSE_TIME=13:00
# Holidays and early-close days default to NYSE's published 2026-2028 calendar
# (src/config/nyse-holidays.ts). Set comma-separated YYYY-MM-DD dates to override, or leave
# empty to trade every weekday.
# MARKET_HOLIDAYS=2026-11-26,2026-12-25
# MARKET_EARLY_CLOSES=2026-11-27,2026-12-24
