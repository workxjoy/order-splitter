{
  "name": "@order-splitter/api",
  "version": "1.0.0",
  "private": true,
  "description": "Order splitter REST API (NestJS)",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@order-splitter/shared": "workspace:*",
    "decimal.js": "^10.6.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "proxy-addr": "^2.0.8",
    "reflect-metadata": "^0.2.2",
    "response-time": "^2.3.4",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.0",
    "@order-splitter/eslint-config": "workspace:*",
    "@order-splitter/tsconfig": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@types/proxy-addr": "^2.0.3",
    "@types/response-time": "^2.3.9",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
