{
  "name": "@order-splitter/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared API contract: Zod schemas, DTO types, enums and limits used by both the API and the web app",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@order-splitter/eslint-config": "workspace:*",
    "@order-splitter/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
